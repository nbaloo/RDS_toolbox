 <#
==============================================================================
HFR - Diagnostic FSLogix / RDS (READ ONLY)
V6 - Nicolas GRUBER - 18.11.2026 - avec l'aide de ChatGPT
  
Objectif :
Identifier le serveur RDS hébergeant actuellement le conteneur FSLogix
d'un utilisateur.
  
Méthode :
- récupération de la liste des serveurs à analyser via le serveur Manager
- tri des serveurs pour se concentrer sur les serveurs RDS
- Lecture parallèle des événements FSLogix / RDS via WinRM.
- Échéance globale de 180 secondes pour les opérations distantes.
- Détection des serveurs candidats (session active, déconnectée ou en erreur).
- Confirmation par présence du volume "Profile-<Utilisateur>".
  
Le script strictement en READ ONLY :
Aucune modification, aucune fermeture de session, aucun démontage de VHD.
  
==============================================================================
#>
  
#requires -Version 5.1
#requires -PSEdition Desktop
[CmdletBinding()]
param(
    [ValidateNotNullOrEmpty()]
    [string]$User = "monuser",
  
    [ValidateRange(1, 525600)]
    [int]$Minutes = 600,
  
    [ValidateRange(1, 256)]
    [int]$ThrottleLimit = 12,
  
    [ValidateRange(1, 86400)]
    [int]$TimeoutSeconds = 180
)
  
# ============================================================
# BLOC 1 - LISTE DES SERVEURS
# ============================================================
  
$ScanStartedAt = Get-Date
$Clock = [System.Diagnostics.Stopwatch]::StartNew()
$DeadlineMs = $TimeoutSeconds * 1000
$DeadlineAt = $ScanStartedAt.AddSeconds($TimeoutSeconds)
$Start = $ScanStartedAt.AddMinutes(-$Minutes)
$ServerListPath = Join-Path $env:APPDATA 'Microsoft\Windows\ServerManager\ServerList.xml'
[xml]$Xml = Get-Content -LiteralPath $ServerListPath -Raw -ErrorAction Stop
  
$Servers = @($Xml.ServerList.ServerInfo.Name |
    Sort-Object -Unique |
    Where-Object { $_ -match 'RDS' -and $_ -notmatch 'BROK|APPEXT|APP|TMPL|MGMT' })
  
if ($Servers.Count -eq 0) {
    Write-Warning "Aucun serveur RDS ne correspond aux filtres dans ServerList.xml."
    return
}
  
# ============================================================
# BLOC 2 - DIAGNOSTIC SUR CHAQUE SERVEUR (READ ONLY)
# ============================================================
  
$RemoteCheck = {
    param([string]$User, [datetime]$Start)
  
    [PSCustomObject]@{ Kind = 'Started' }
  
    $Logs = @(
        "Microsoft-FSLogix-Apps/Operational",
        "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational",
        "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational"
    )
  
    $g = @(& {
        foreach ($Log in $Logs) {
  
            try {
                # Filtre different selon le journal
                $Filter = @{
                    LogName   = $Log
                    StartTime = $Start
                }
  
                if ($Log -eq "Microsoft-FSLogix-Apps/Operational") {
                    $Filter.Id = @(25)
                }
                elseif ($Log -eq "Microsoft-Windows-TerminalServices-LocalSessionManager/Operational") {
                    $Filter.Id = @(21,22,23,24,41,42)
                }
                elseif ($Log -eq "Microsoft-Windows-TerminalServices-RemoteConnectionManager/Operational") {
                    $Filter.Id = @(1149)
                }
  
                $RawEvents = Get-WinEvent -FilterHashtable $Filter -ErrorAction Stop
            }
            catch {
                continue
            }
  
            $RawEvents |
            Where-Object { $_.Message -match [regex]::Escape($User) } |
            ForEach-Object {
                $Msg = ($_.Message -replace "`r|`n"," " -replace "\s+"," ").Trim()
  
                $Action = switch -Regex ($Msg) {
                    "User authentication succeeded" { "AUTH"; break }
                    "Session logon succeeded"       { "LOGON"; break }
                    "Shell start"                   { "SHELL"; break }
                    "Session logoff succeeded"      { "LOGOFF"; break }
                    "Session has been disconnected" { "DISCO"; break }
                    "Profile load.*Status:\s*0"     { "FSLOAD"; break }
                    "Profile load"                  { "FSLOAD_ERR"; break }
                    "error|failed|denied|lock"      { "ERROR"; break }
                    default                         { "INFO" }
                }
  
                [PSCustomObject]@{
                    Kind      = "Event"
                    Time      = $_.TimeCreated
                    Server    = $env:COMPUTERNAME
                    Action    = $Action
                    Id        = $_.Id
                    SessionId = if ($Msg -match "Session ID:\s*(\d+)") { $matches[1] } else { "" }
                }
            }
        }
    } | Sort-Object Time)
  
    $Candidate = $null
    if ($g.Count -gt 0) {
        $last = $g[-1]
        $LogonCount = @($g | Where-Object Action -eq 'LOGON').Count
        $LogoffCount = @($g | Where-Object Action -eq 'LOGOFF').Count
        $SessionBalance = $LogonCount - $LogoffCount
        $hasFsload = $g.Action -contains "FSLOAD"
        $hasLogoff = $LogoffCount -gt 0
        $hasDisco  = $g.Action -contains "DISCO"
        $hasError  = ($g.Action -contains "ERROR") -or ($g.Action -contains "FSLOAD_ERR")
  
        $IsSuspect = $false
        $Reason = ""
  
        if ($hasError) {
            $IsSuspect = $true
            $Reason = "ERREUR/LOCK possible"
        }
        elseif ($hasFsload -and -not $hasLogoff) {
            $IsSuspect = $true
            $Reason = "profil FSLogix charge sans logoff detecte"
        }
        elseif ($SessionBalance -gt 0) {
            $IsSuspect = $true
            $Reason = "Solde positif des sessions (LOGON=$LogonCount, LOGOFF=$LogoffCount)"
        }
        elseif ($hasDisco -and -not $hasLogoff) {
            $IsSuspect = $true
            $Reason = "session deconnectee sans logoff"
        }
  
        $Candidate = [PSCustomObject]@{
            Kind       = "Candidate"
            Server     = $env:COMPUTERNAME
            Last       = $last.Time
            LastAction = $last.Action
            SessionId  = $last.SessionId
            IsSuspect  = $IsSuspect
            Reason     = $Reason
        }
    }
  
    # Publier les événements avant Get-Volume, qui peut lui aussi bloquer.
    $g
    if ($Candidate) { $Candidate }
  
    if ($Candidate -and $Candidate.IsSuspect) {
        Get-Volume -ErrorAction Stop |
            Where-Object { $_.FileSystemLabel -eq "Profile-$User" } |
            ForEach-Object {
                [PSCustomObject]@{
                    Kind   = 'Volume'
                    Server = $env:COMPUTERNAME
                    Label  = $_.FileSystemLabel
                    FreeGB = [math]::Round($_.SizeRemaining / 1GB, 2)
                    SizeGB = [math]::Round($_.Size / 1GB, 2)
                }
            }
    }
}
  
# ============================================================
# BLOC 3 - COLLECTE PARALLELE ET ECHEANCE GLOBALE
# ============================================================
  
# Le processus local dédié permet de couper la collecte sans attendre Stop-Job.
$Worker = {
    $ErrorActionPreference = 'Stop'
    $Folder = $env:HFR_FSLOGIX_SCAN
    try {
        $Config = Import-Clixml -LiteralPath (Join-Path $Folder 'config.xml')
        $SessionOption = New-PSSessionOption -OpenTimeout 12000
        $Job = Invoke-Command -ComputerName ([string[]]$Config.Servers) -AsJob `
            -ThrottleLimit $Config.ThrottleLimit -SessionOption $SessionOption `
            -ScriptBlock ([scriptblock]::Create($Config.RemoteCheck)) `
            -ArgumentList $Config.User, $Config.Start
  
        $Index = 0
        $Pending = @($Job.ChildJobs)
        while ($Pending.Count -gt 0) {
            $Pending = @(foreach ($Child in $Pending) {
                $State = [string]$Child.State
                $Finished = $State -in 'Completed', 'Failed', 'Stopped', 'Disconnected'
                if ($Child.HasMoreData -or $Finished) {
                    $ReceiveErrors = @()
                    $Output = @(Receive-Job -Job $Child -ErrorAction SilentlyContinue `
                        -ErrorVariable ReceiveErrors -WarningAction SilentlyContinue `
                        -InformationAction SilentlyContinue)
                    $Details = @($ReceiveErrors | ForEach-Object { $_.ToString() })
                    if ($Finished -and $Child.JobStateInfo.Reason -and -not $Details.Count) {
                        $Details = @($Child.JobStateInfo.Reason.Message)
                    }
                    if ($Finished -or $Output.Count -or $Details.Count) {
                        $Record = [PSCustomObject]@{
                            Server  = $Child.Location
                            Output  = $Output
                            State   = $State
                            Final   = $Finished
                            Errors  = $Details
                        }
  
                        # Renommer après écriture pour ignorer un fichier incomplet au timeout.
                        $File = Join-Path $Folder ('result-{0:D6}.xml' -f $Index)
                        $Record | Export-Clixml -LiteralPath "$File.tmp" -Depth 8
                        [System.IO.File]::Move("$File.tmp", $File)
                        $Index++
                    }
                }
                if (-not $Finished) { $Child }
            })
            if ($Pending.Count -gt 0) { Start-Sleep -Milliseconds 100 }
        }
    }
    catch {
        $_.ToString() | Set-Content -LiteralPath (Join-Path $Folder 'error.txt') -Encoding UTF8
        exit 1
    }
    exit 0
}
  
Write-Host ("Collecte WinRM sur {0} serveurs | Parallelisme : {1} | Limite globale : {2} s" -f `
    $Servers.Count, $ThrottleLimit, $TimeoutSeconds) -ForegroundColor Cyan
  
Write-Host ("Début collecte à      : {0:dd.MM.yyyy HH:mm:ss}" -f $ScanStartedAt)
Write-Host ("Échéance de collecte  : {0:dd.MM.yyyy HH:mm:ss}" -f $DeadlineAt)
  
$Folder = Join-Path ([System.IO.Path]::GetTempPath()) ("HFR-FSLogix-" + [guid]::NewGuid())
$null = New-Item -Path $Folder -ItemType Directory -ErrorAction Stop
$Process = $null
$TimedOut = $false
$CollectorError = $null
$Records = New-Object 'System.Collections.Generic.List[object]'
$ReadErrors = New-Object 'System.Collections.Generic.List[string]'
$ServersWithErrors = @{}
$NextRecord = 0
try {
    [PSCustomObject]@{
        Servers       = [string[]]$Servers
        User          = $User
        Start         = $Start
        ThrottleLimit = $ThrottleLimit
        RemoteCheck   = $RemoteCheck.ToString()
    } | Export-Clixml -LiteralPath (Join-Path $Folder 'config.xml') -ErrorAction Stop
  
    $ProcessInfo = New-Object System.Diagnostics.ProcessStartInfo
    $ProcessInfo.FileName = Join-Path $PSHOME 'powershell.exe'
    $EncodedWorker = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($Worker.ToString()))
    $ProcessInfo.Arguments = "-NoLogo -NoProfile -NonInteractive -EncodedCommand $EncodedWorker"
    $ProcessInfo.UseShellExecute = $false
    $ProcessInfo.CreateNoWindow = $true
    $ProcessInfo.EnvironmentVariables['HFR_FSLOGIX_SCAN'] = $Folder
  
    if ($Clock.ElapsedMilliseconds -lt $DeadlineMs) {
        $Process = [System.Diagnostics.Process]::Start($ProcessInfo)
        do {
            $RemainingMs = $DeadlineMs - $Clock.ElapsedMilliseconds
            $WaitMs = [int][Math]::Max(0, [Math]::Min(250, $RemainingMs))
            $Exited = $Process.WaitForExit($WaitMs)
            $TimedOut = -not $Exited -and $Clock.ElapsedMilliseconds -ge $DeadlineMs
            if ($TimedOut -and -not $Process.HasExited) {
                try { $Process.Kill() }
                catch [System.InvalidOperationException] {
                    if (-not $Process.HasExited) { throw }
                }
            }
  
            # Le collecteur publie chaque fichier complet avec un index consécutif.
            $RecordPath = Join-Path $Folder ('result-{0:D6}.xml' -f $NextRecord)
            while (Test-Path -LiteralPath $RecordPath -PathType Leaf) {
                $Record = $null
                for ($Attempt = 1; $Attempt -le 5; $Attempt++) {
                    try {
                        $Record = Import-Clixml -LiteralPath $RecordPath -ErrorAction Stop
                        break
                    }
                    catch {
                        $RetryMs = [int][Math]::Min(100, ($DeadlineMs - $Clock.ElapsedMilliseconds))
                        if ($Attempt -eq 5 -or $RetryMs -le 0) {
                            $ReadErrors.Add(("{0} | {1}" -f [IO.Path]::GetFileName($RecordPath), $_.Exception.Message))
                            break
                        }
                        Start-Sleep -Milliseconds $RetryMs
                    }
                }
  
                if ($null -ne $Record) {
                    $Records.Add($Record)
  
                    if ($Record.Errors.Count) {
                        $ServersWithErrors[$Record.Server] = $true
                    }
                    if ($Record.Final -and $Record.State -eq 'Completed' -and
                        -not $ServersWithErrors.ContainsKey($Record.Server)) {
                        Write-Host ("récolte sur {0} OK" -f $Record.Server) -ForegroundColor Green
                    }
                }
  
                $NextRecord++
                if (-not $Exited -and -not $TimedOut -and $Clock.ElapsedMilliseconds -ge $DeadlineMs) { break }
                $RecordPath = Join-Path $Folder ('result-{0:D6}.xml' -f $NextRecord)
            }
        } until ($Exited -or $TimedOut)
  
        if (-not $TimedOut -and $Process.ExitCode -ne 0) {
            $ErrorPath = Join-Path $Folder 'error.txt'
            $CollectorError = if (Test-Path -LiteralPath $ErrorPath) {
                Get-Content -LiteralPath $ErrorPath -Raw
            }
            else {
                "Le processus de collecte a quitte avec le code $($Process.ExitCode)."
            }
        }
    }
    else {
        $TimedOut = $true
    }
  
    $ScanDuration = $Clock.Elapsed
}
catch {
    $ScanDuration = $Clock.Elapsed
    $CollectorError = $_.ToString()
}
finally {
    if ($Process) {
        if (-not $TimedOut -and -not $Process.HasExited) {
            try { $Process.Kill() } catch [System.InvalidOperationException] {}
        }
        $Process.Dispose()
    }
    Remove-Item -LiteralPath $Folder -Recurse -Force -ErrorAction SilentlyContinue
}
  
# ============================================================
# BLOC 4 - RESULTATS PAR SERVEUR
# ============================================================
  
$RecordsByServer = @{}
foreach ($Group in ($Records | Group-Object Server)) {
    $RecordsByServer[$Group.Name] = $Group.Group
}
  
$ServerResults = @(foreach ($Server in $Servers) {
    $ServerRecords = @($RecordsByServer[$Server] | Where-Object { $_ })
    $Output = @($ServerRecords | ForEach-Object { $_.Output })
    $Final = $ServerRecords | Where-Object Final | Select-Object -Last 1
    $Candidate = $Output | Where-Object Kind -eq 'Candidate' | Select-Object -Last 1
    $Connected = 'Started' -in $Output.Kind
    $Details = @($ServerRecords | ForEach-Object { $_.Errors })
  
    $Status = if ($Final -and $Final.State -eq 'Completed' -and -not $Details.Count) { 'OK' }
    elseif ($Final) {
        if ($Connected) { 'ERREUR' } else { 'ECHEC WINRM' }
    }
    elseif ($TimedOut) { 'TIMEOUT GLOBAL' }
    else { 'INCOMPLET' }
  
    $Phase = if ($Candidate.IsSuspect) { 'Volume FSLogix' }
    elseif ($Connected) { 'Evenements' }
    else { 'Connexion / file WinRM' }
  
    [PSCustomObject]@{
        Server     = $Server
        Status     = $Status
        Phase      = $Phase
        Connected  = $Connected
        Events     = @($Output | Where-Object Kind -eq 'Event')
        Candidate  = $Candidate
        Volumes    = @($Output | Where-Object Kind -eq 'Volume')
        Detail     = ($Details -join ' | ')
    }
})
  
$Events = @($ServerResults | ForEach-Object { $_.Events } |
    Where-Object { $_ } | Sort-Object Time)
$Suspects = @($ServerResults | ForEach-Object { $_.Candidate } |
    Where-Object { $_.IsSuspect })
$VolumeCheck = @($ServerResults | ForEach-Object { $_.Volumes } |
    Sort-Object Server)
$ConnectedCount = @($ServerResults | Where-Object Connected).Count
$CompletedCount = @($ServerResults | Where-Object Status -eq 'OK').Count
$Incomplete = @($ServerResults | Where-Object Status -ne 'OK')
  
# ============================================================
# BLOC 5 - RAPPORT FINAL
# ============================================================
  
cls
  
Write-Host ""
Write-Host "        HFR - Diagnostic FSLogix / RDS (READ ONLY)" -ForegroundColor Cyan
Write-Host "==============================================================" -ForegroundColor Cyan
Write-Host ("Utilisateur       : {0}" -f $User)
Write-Host ("Fenetre analyse   : {0} minutes" -f $Minutes)
Write-Host ("Duree du scan     : {0}" -f $ScanDuration.ToString("hh\:mm\:ss\.fff"))
Write-Host ("Date              : {0}" -f (Get-Date).ToString("dd.MM.yyyy HH:mm:ss"))
if ($TimedOut) { Write-Warning "Limite globale de $TimeoutSeconds s atteinte. Rapport partiel." }
if ($CollectorError) { Write-Warning "Collecteur interrompu. Rapport partiel. $CollectorError" }
if ($ReadErrors.Count) {
    Write-Warning ("Rapport partiel. Fichiers de résultat illisibles : {0}" -f $ReadErrors.Count)
    foreach ($ReadError in $ReadErrors) { Write-Warning $ReadError }
}
  
Write-Host ""
Write-Host "ETAPES 1 ET 2 - CONNECTIVITE ET COLLECTE WINRM" -ForegroundColor Cyan
Write-Host "==============================================================" -ForegroundColor Cyan
Write-Host ("Serveurs cibles        : {0}" -f $Servers.Count)
Write-Host ("Connectes              : {0}" -f $ConnectedCount)
Write-Host ("Diagnostics termines   : {0}" -f $CompletedCount)
  
foreach ($Result in $Incomplete) {
    Write-Host (" - {0} | {1} | {2}" -f $Result.Server, $Result.Status, $Result.Phase) -ForegroundColor Yellow
    if ($Result.Detail) { Write-Host ("   {0}" -f $Result.Detail) -ForegroundColor Gray }
}
  
Write-Host ""
Write-Host "ETAPE 3 - TIMELINE DES EVENEMENTS" -ForegroundColor Cyan
Write-Host "==============================================================" -ForegroundColor Cyan
  
if ($Events.Count) {
    foreach ($e in $Events) {
        $Color = switch ($e.Action) {
            "LOGOFF"     { "Green" }
            "FSLOAD"     { "Green" }
            "LOGON"      { "Green" }
            "SHELL"      { "DarkGreen" }
            "DISCO"      { "Yellow" }
            "ERROR"      { "Red" }
            "FSLOAD_ERR" { "Red" }
            default      { "Gray" }
        }
  
        Write-Host ("{0:HH:mm:ss}  {1,-14} {2,-8} SID:{3,-3} ID:{4}" -f $e.Time,$e.Server,$e.Action,$e.SessionId,$e.Id) -ForegroundColor $Color
    }
}
else {
    Write-Host "Aucun evenement recu pour cet utilisateur dans la fenetre analysee." -ForegroundColor Yellow
}
  
Write-Host ""
Write-Host "ETAPE 4 - ANALYSE" -ForegroundColor Cyan
Write-Host "==============================================================" -ForegroundColor Cyan
  
Write-Host ("Nombre de serveurs candidats au controle volume : {0}" -f $Suspects.Count)
Write-Host ""
  
if ($Suspects.Count -gt 0) {
    foreach ($s in ($Suspects | Sort-Object Last -Descending)) {
        Write-Host $s.Server -ForegroundColor Yellow
        Write-Host ("  Derniere action : {0}" -f $s.LastAction)
        Write-Host ("  Session         : {0}" -f $s.SessionId)
        Write-Host ("  Analyse         : {0}" -f $s.Reason)
        Write-Host ""
    }
}
else {
    Write-Host "Aucun serveur candidat detecte pour le controle volume." -ForegroundColor Green
}
  
Write-Host "ETAPE 5 - CONTROLE FSLOGIX" -ForegroundColor Cyan
Write-Host "==============================================================" -ForegroundColor Cyan
  
if ($VolumeCheck.Count -gt 0) {
    foreach ($v in $VolumeCheck) {
        Write-Host $v.Server -ForegroundColor Magenta
        Write-Host ("  Volume detecte : {0}" -f $v.Label)
        Write-Host ("  Taille         : {0} GB" -f $v.SizeGB)
        Write-Host ("  disponible     : {0} GB" -f $v.FreeGB)
        Write-Host ""
    }
  
    Write-Host "==============================================================" -ForegroundColor Magenta
    Write-Host "RESULTAT : " -ForegroundColor Magenta -NoNewline
    Write-Host ("Volume {0} sur {1}" -f $VolumeCheck[0].Label, ($VolumeCheck.Server -join ", ")) -ForegroundColor Green
    Write-Host "==============================================================" -ForegroundColor Magenta
  
  
}
elseif ($Suspects.Count -gt 0) {
    Write-Host "Aucun volume Profile-$User dans les resultats recus." -ForegroundColor Yellow
}
else {
    Write-Host "Controle ignore : aucun serveur candidat." -ForegroundColor Green
}
 

